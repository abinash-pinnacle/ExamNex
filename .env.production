# ===== ExamNex — Production (.env) for Hostinger =====
# Rename this file to ".env" on the server and fill the DB values from hPanel.

APP_NAME=ExamNex
APP_ENV=production
APP_KEY=base64:kSquH8pRWRWW7KKCElYm/hUXi/qVputq532rObVOd8Y=
APP_DEBUG=false
APP_URL=https://exam.cmsnmietbschool.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=error

# ---- MySQL (create in hPanel → Databases → MySQL, paste values here) ----
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=REPLACE_db_name
DB_USERNAME=REPLACE_db_user
DB_PASSWORD=REPLACE_db_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@cmsnmietbschool.in"
MAIL_FROM_NAME="${APP_NAME}"

# ---- AI question generation (optional) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- One-time setup key: open  https://your-domain/deploy-setup/CHANGE-ME-abc123
#      to create tables + demo data WITHOUT SSH. DELETE this line after setup. ----
SETUP_KEY=CHANGE-ME-abc123xyz789
